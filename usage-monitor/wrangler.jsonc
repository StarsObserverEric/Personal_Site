{
  "name": "ecnu-usage-monitor",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",

  // 不绑任何自定义域（用户要求：不要新域名）。
  // 保留 workers.dev 作为纯运维兜底（/run 手动触发、/export.csv，均 Bearer 保护）——
  // 用户日常根本不需要知道这个地址：CSV 会自动落到网盘 /Admin_Private/ecnu_usage.csv。
  "workers_dev": true,

  // ═══════════════ 定时任务（已删除，2026-10-10） ═══════════════
  // 曾经有 "crons": ["*/2 * * * *"]（每 2 分钟自动采集）。已删：cron 每次唤醒
  // 都会把 ecnu_usage_log 整张表读一遍（生成 CSV 指纹用），读取量 = 720 次/天 ×
  // 表行数，随表增长线性放大，两天就把账户级 D1 免费额度（500 万行读/天）吃穿。
  // 现在 Worker 只保留手动模式：POST/GET /run 手动采集、/export.csv 手动导出。
  // 若要恢复定时：加回 triggers.crons，且 scheduled 里别再全表扫描
  // （只取 ORDER BY id DESC LIMIT 1 的最后一行即可把读取降到 1 行/次）。

  // ═══════════════ D1 存储 ═══════════════
  // 复用 netdisk 的 cloud-r2pan 数据库（同一个库，独立的表 ecnu_usage_log，互不干扰）。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloud-r2pan",
      "database_id": "10a5da07-2dbd-4944-a72b-a651070b645d"
    }
  ],

  // ═══════════════ 网盘回写目标（非密钥，明文变量） ═══════════════
  // 采集到新数据后，把 CSV 回写到 netdisk 的这个目录（走 Admin API，凭证走 secrets）。
  "vars": {
    "NETDISK_BASE": "https://disk.starsobservereric.cc.cd",
    "DISK_DIR": "/Admin_Private"
  },

  "observability": { "enabled": true }
}
