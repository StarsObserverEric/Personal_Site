{
  "name": "ecnu-usage-monitor",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",

  // 不绑任何自定义域（用户要求：不要新域名）。
  // 保留 workers.dev 作为纯运维兜底（/run 手动触发、/export.csv，均 Bearer 保护）——
  // 用户日常根本不需要知道这个地址：CSV 会自动落到网盘 /Admin_Private/ecnu_usage.csv。
  "workers_dev": true,

  // ═══════════════ 定时任务 ═══════════════
  // 每 2 分钟拉一次 ECNU 用量接口（相当于替你点一次"刷新数据"按钮背后的请求）。
  "triggers": {
    "crons": ["*/2 * * * *"]
  },

  // ═══════════════ D1 存储 ═══════════════
  // 复用 netdisk 的 cloud-r2pan 数据库（同一个库，独立的表 ecnu_usage_log，互不干扰）。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloud-r2pan",
      "database_id": "10a5da07-2dbd-4944-a72b-a651070b645d"
    }
  ],

  // ═══════════════ 网盘回写目标（非密钥，明文变量） ═══════════════
  // 采集到新数据后，把 CSV 回写到 netdisk 的这个目录（走 Admin API，凭证走 secrets）。
  "vars": {
    "NETDISK_BASE": "https://disk.starsobservereric.cc.cd",
    "DISK_DIR": "/Admin_Private"
  },

  "observability": { "enabled": true }
}
