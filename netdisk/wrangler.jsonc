{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloud-r2pan",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",

  // ═══════════════ 自定义域（wrangler deploy 时自动绑定） ═══════════════
  // custom_domain:true 会让 wrangler 直接在 Cloudflare 上把该子域绑到本 Worker，
  // 无需再去控制台手点。zone starsobservereric.cc.cd 已在本账号，令牌含 Workers 路由:编辑。
  "routes": [
    { "pattern": "disk.starsobservereric.cc.cd", "custom_domain": true }
  ],

  // ═══════════════ 基础设施资源绑定（自动查找/创建） ═══════════════
  // 本地开发时 wrangler dev 自动创建本地实例；
  // 生产部署时自动在 Cloudflare 上查找同名资源并绑定。
  // 如果 Cloudflare 控制台已手动配置同名绑定，会优先复用控制台配置，不会覆盖。
  "d1_databases": [
    {
      "binding": "db",
      "database_name": "cloud-r2pan",
      "database_id": "10a5da07-2dbd-4944-a72b-a651070b645d"
    }
  ],
  // ⚠️ R2 是可选的 —— 如果你改用其他 S3 兼容存储（见下方 analytics_engine_datasets），
  //    可以注释掉这个 r2_buckets 块，把存储完全交给外部 S3。
  "r2_buckets": [
    {
      "binding": "r2",
      "bucket_name": "cloud-r2pan"
    }
  ],

  // ═══════════════ Workers Analytics Engine（全球分布分析）—— 已停用 ═══════════════
  // 为什么停用：Analytics Engine 是**账号级**功能，必须在控制台一次性启用，
  // 否则 wrangler deploy 直接失败：
  //   ✘ [ERROR] You need to enable Analytics Engine. [code: 10089]
  // 而且它属于 Workers **付费**套餐能力（免费版仅 10 万次写入/天级别甚至不可用）。
  //
  // 代码里这个绑定本来就是**可选**的：
  //   - types.ts:      analytics?: AnalyticsEngineDataset        （问号 = 可选）
  //   - public.ts:606  if (env.analytics) { … }                  （有守卫）
  //   - admin.ts       analytics_engine_available: !!env.analytics
  // 不绑定时，"全球分布"Tab 自动降级用 D1 的 download_logs（无经纬度，只有国家）。
  //
  // 想恢复（需先升级 Workers 付费套餐 + 在控制台启用 Analytics Engine），
  // 把下面这段的注释去掉再部署即可：
  //
  // "analytics_engine_datasets": [
  //   {
  //     "binding": "analytics",
  //     "dataset": "r2pan_downloads"
  //   }
  // ],

  // ═══════════════ 密钥/敏感配置（不在仓库中声明） ═══════════════
  // 本地开发：创建 .dev.vars 文件（已 .gitignore）写入 admin=你的密钥
  // 生产环境：通过 Cloudflare 控制台 → Worker → Settings → Secrets 添加
  //          或执行 npx wrangler secret put admin

  // 将 public/*.html 作为文本模块导入
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true }
  ],

  "observability": { "enabled": true }
}
